{
  "include": [
    "apps",
    "packages",
    "extensions",
    "src",
    "tools",
    "tests",
    "examples"
  ],
  "extraPaths": [
    "apps/desktop/src",
    "apps/cli/src",
    "packages/agent_runtime/src",
    "packages/channels_core/src",
    "packages/config_core/src",
    "packages/gateway_protocol/src",
    "packages/hooks_core/src",
    "packages/i18n_core/src",
    "packages/llm_client/src",
    "packages/memory_host_sdk/src",
    "packages/normalization_core/src",
    "packages/plugin_sdk/src",
    "packages/retry/src",
    "packages/state_core/src",
    "src"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.git",
    "**/.hg",
    "**/.svn",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.ipynb_checkpoints",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/__pycache__",
    "**/*.pyc",
    "**/*.pyo",
    "**/*.pyd",
    "**/site-packages",
    "**/node_modules",
    "**/bower_components",
    "**/CVS",
    "**/.DS_Store",
    "**/.vscode",
    "**/.idea",
    "**/legacy_*",
    "openclaw-main",
    ".venv",
    "venv",
    "build",
    "dist",
    "config",
    "**/jarvis_desktop/app.py",
    "**/jarvis_desktop/ui.py"
  ],
  "pythonVersion": "3.13",
  "typeCheckingMode": "standard",
  "useLibraryCodeForTypes": true,
  "reportMissingImports": "error",
  "reportMissingTypeStubs": false,
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportUnknownMemberType": "warning",
  "reportUnknownArgumentType": "warning",
  "reportUnknownVariableType": "warning",
  "reportUnknownParameterType": "warning",
  "reportMissingParameterType": "warning",
  "reportMissingTypeArgument": "warning",
  "reportAttributeAccessIssue": "warning",
  "reportTypedDictNotRequiredAccess": "warning"
}
