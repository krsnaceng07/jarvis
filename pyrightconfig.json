{
  "include": [
    "apps",
    "packages",
    "extensions",
    "src",
    "tools",
    "tests",
    "examples"
  ],
  "extraPaths": [
    "apps/cli/src",
    "apps/desktop/src",
    "apps/tui/src",
    "packages/acp_core/src",
    "packages/agent_runtime/src",
    "packages/ai/src",
    "packages/audio_core/src",
    "packages/channels_core/src",
    "packages/cli_backend/src",
    "packages/client_runtime/src",
    "packages/config_core/src",
    "packages/cron_core/src",
    "packages/events_core/src",
    "packages/gateway_protocol/src",
    "packages/hooks_core/src",
    "packages/i18n_core/src",
    "packages/learning_core/src",
    "packages/live_session/src",
    "packages/llm_client/src",
    "packages/logging_core/src",
    "packages/markdown_core/src",
    "packages/mcp_core/src",
    "packages/media_core/src",
    "packages/media_generation_core/src",
    "packages/media_understanding_common/src",
    "packages/memory_host_sdk/src",
    "packages/mermaid_renderer/src",
    "packages/model_catalog_core/src",
    "packages/net_policy/src",
    "packages/normalization_core/src",
    "packages/plugin_package_contract/src",
    "packages/plugin_sdk/src",
    "packages/retry/src",
    "packages/retry_core/src",
    "packages/sdk/src",
    "packages/secrets_core/src",
    "packages/session_core/src",
    "packages/session_url_contract/src",
    "packages/state_core/src",
    "packages/terminal_core/src",
    "packages/tool_call_repair/src",
    "packages/transcript_core/src",
    "packages/voice_pipeline/src",
    "packages/workboard_contract/src",
    "packages/worker_runtime/src",
    "src"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.git",
    "**/.hg",
    "**/.svn",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.ipynb_checkpoints",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/*.pyc",
    "**/*.pyo",
    "**/*.pyd",
    "**/site-packages",
    "**/node_modules",
    "**/bower_components",
    "**/CVS",
    "**/.DS_Store",
    "**/.vscode",
    "**/.idea",
    "**/legacy_*",
    "openclaw-main",
    ".venv",
    "venv",
    "build",
    "dist",
    "config"
  ],
  "pythonVersion": "3.13",
  "typeCheckingMode": "standard",
  "useLibraryCodeForTypes": true,
  "reportMissingImports": "error",
  "reportMissingTypeStubs": false,
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportAttributeAccessIssue": "warning",
  "reportTypedDictNotRequiredAccess": "warning"
}
