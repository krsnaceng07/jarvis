{
  "id": "mattermost",
  "name": "Mattermost",
  "description": "OpenClaw Mattermost channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "mattermost"
  ],
  "channelEnvVars": {
    "mattermost": [
      "MATTERMOST_URL",
      "MATTERMOST_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
