{
  "id": "tool_web_search",
  "activation": "on_startup",
  "kind": "tool",
  "contracts": {
    "tools": ["web_search"]
  },
  "permissions": ["network:outbound"],
  "tools": [
    {
      "name": "web_search",
      "description": "Performs a web search and returns a summary of the top results.",
      "parameters": [
        { "name": "query", "type": "string", "required": false, "description": "The search query." },
        { "name": "mode", "type": "string", "required": false, "description": "search | compare (default: search)." },
        { "name": "items", "type": "string", "required": false, "description": "Comma-separated items to compare." },
        { "name": "aspect", "type": "string", "required": false, "description": "Aspect to compare on." }
      ]
    }
  ]
}
