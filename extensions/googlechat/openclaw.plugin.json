{
  "id": "googlechat",
  "name": "Google Chat",
  "description": "OpenClaw Google Chat channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "googlechat"
  ],
  "channelEnvVars": {
    "googlechat": [
      "GOOGLE_CHAT_WEBHOOK_URL"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
