{
  "id": "vercel-ai-gateway",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "vercel-ai-gateway"
  ],
  "setup": {
    "providers": [
      {
        "id": "vercel-ai-gateway",
        "authMethods": [
          "api-key"
        ],
        "envVars": [
          "VERCEL_AI_GATEWAY_KEY"
        ]
      }
    ]
  },
  "modelCatalog": {
    "providers": {
      "vercel-ai-gateway": {
        "baseUrl": "https://ai-gateway.vercel.sh/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "vercel-auto",
            "input": [
              "text"
            ]
          }
        ]
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "default_model": {
        "type": "string"
      },
      "max_output_tokens": {
        "type": "integer"
      }
    }
  }
}
