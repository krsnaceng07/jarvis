{
  "id": "nextcloud-talk",
  "name": "Nextcloud Talk",
  "description": "OpenClaw Nextcloud Talk channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "nextcloud-talk"
  ],
  "channelEnvVars": {
    "nextcloud-talk": [
      "NEXTCLOUD_TALK_URL",
      "NEXTCLOUD_TALK_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
