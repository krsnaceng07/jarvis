  "name": "Nextcloud Talk",
  "description": "JARVIS Nextcloud Talk channel plugin for conversation rooms.",
  "channels": [
    "nextcloud-talk"
  ],
  "activation": {
    "onStartup": false
  },
  "configSchema": {
