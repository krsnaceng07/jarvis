{
  "id": "cua-computer",
  "name": "CUA Computer",
  "description": "Experimental CUA Driver computer control for macOS, Windows, and Linux node hosts.",
  "entry": "plugin.py",
  "activation": {
    "onStartup": true
  },
  "enabledByDefault": true,
  "permissions": [
    "tool:execute",
    "input:synthesize",
    "screen:capture",
    "overlay:draw",
    "process:inspect"
  ],
  "contracts": {
    "tools": ["computer"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "driverPath": {
        "type": "string"
      }
    }
  },
  "kind": "tool"
}
