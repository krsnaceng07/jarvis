{
  "id": "webhooks",
  "name": "Webhooks",
  "kind": "infra",
  "version": "0.1.0",
  "description": "Authenticated inbound webhooks that bind external automation to OpenClaw TaskFlows.",
  "activation": {
    "onStartup": true,
    "onDemand": true
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "routes.*.secret",
          "expected": "string",
          "ownerKind": "route"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "secretRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": ["env", "file", "exec", "store"]
          },
          "provider": { "type": "string" },
          "id": { "type": "string" }
        },
        "required": ["source", "provider", "id"]
      },
      "secretInput": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/secretRef" }
        ]
      },
      "route": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "path": { "type": "string", "minLength": 1 },
          "sessionKey": { "type": "string", "minLength": 1 },
          "secret": { "$ref": "#/$defs/secretInput" },
          "controllerId": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        },
        "required": ["sessionKey", "secret"]
      }
    },
    "properties": {
      "routes": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/route"
        }
      }
    }
  }
}
