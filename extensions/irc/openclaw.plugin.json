{
  "id": "irc",
  "name": "IRC",
  "description": "OpenClaw IRC channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "irc"
  ],
  "channelEnvVars": {
    "irc": [
      "IRC_HOST",
      "IRC_PORT",
      "IRC_TLS",
      "IRC_NICK",
      "IRC_USERNAME",
      "IRC_REALNAME",
      "IRC_PASSWORD"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
