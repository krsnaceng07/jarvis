{
  "id": "comfy",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "comfy"
  ],
  "setup": {
    "providers": [
      {
        "id": "comfy",
        "authMethods": [
          "api-key"
        ],
        "envVars": [
          "COMFY_HOST"
        ]
      }
    ]
  },
  "modelCatalog": {
    "providers": {
      "comfy": {
        "baseUrl": "http://localhost:8188",
        "api": "openai-completions",
        "models": []
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "default_model": {
        "type": "string"
      },
      "max_output_tokens": {
        "type": "integer"
      }
    }
  }
}
