{
  "id": "openai",
  "activation": "on_startup",
  "kind": "provider",
  "contracts": {
    "provider": true
  },
  "permissions": [
    "network:outbound"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "api_key": {
        "type": "string",
        "description": "OpenAI API key."
      },
      "organization": {
        "type": "string",
        "description": "OpenAI organization id."
      },
      "default_model": {
        "type": "string",
        "default": "gpt-5"
      },
      "max_output_tokens": {
        "type": "integer",
        "default": 8192
      }
    },
    "required": [
      "api_key"
    ]
  }
}