{
  "id": "zalo",
  "name": "Zalo",
  "description": "OpenClaw Zalo channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "zalo"
  ],
  "channelEnvVars": {
    "zalo": [
      "ZALO_OA_ACCESS_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
