{
  "id": "twitch",
  "name": "Twitch",
  "description": "OpenClaw Twitch channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "twitch"
  ],
  "channelEnvVars": {
    "twitch": [
      "OPENCLAW_TWITCH_ACCESS_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
