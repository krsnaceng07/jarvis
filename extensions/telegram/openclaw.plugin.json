{
  "id": "telegram",
  "activation": "on_startup",
  "kind": "channel",
  "contracts": {
    "channel": true
  },
  "permissions": ["network:outbound"],
  "configSchema": {
    "type": "object",
    "properties": {
      "bot_token": { "type": "string", "description": "Telegram Bot API token." },
      "polling_interval_sec": { "type": "integer", "default": 1, "minimum": 1 }
    },
    "required": ["bot_token"]
  }
}
