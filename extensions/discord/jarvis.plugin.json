{
  "id": "discord",
  "activation": "on_startup",
  "kind": "channel",
  "contracts": {
    "channel": true
  },
  "permissions": [
    "network:outbound"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "bot_token": {
        "type": "string",
        "description": "Discord bot token."
      },
      "application_id": {
        "type": "string",
        "description": "Discord application id."
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 2,
        "minimum": 1
      }
    },
    "required": [
      "bot_token",
      "application_id"
    ]
  }
}