{
  "id": "qqbot",
  "name": "QQ Bot",
  "description": "OpenClaw QQ Bot channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "qqbot"
  ],
  "channelEnvVars": {
    "qqbot": [
      "QQBOT_APP_ID",
      "QQBOT_APP_SECRET"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
