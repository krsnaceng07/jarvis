{
  "id": "imessage",
  "name": "iMessage",
  "description": "OpenClaw iMessage channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "imessage"
  ],
  "channelEnvVars": {
    "imessage": [
      "IMESSAGE_BRIDGE_URL",
      "IMESSAGE_BRIDGE_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
