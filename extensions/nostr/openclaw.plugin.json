{
  "id": "nostr",
  "name": "Nostr",
  "description": "OpenClaw Nostr channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "nostr"
  ],
  "channelEnvVars": {
    "nostr": [
      "NOSTR_RELAY_URL",
      "NOSTR_PRIVATE_KEY"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
