{
  "id": "clickclack",
  "name": "ClickClack",
  "description": "OpenClaw ClickClack channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "clickclack"
  ],
  "channelEnvVars": {
    "clickclack": [
      "CLICKCLACK_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
