{
  "id": "anthropic",
  "activation": "on_startup",
  "kind": "provider",
  "contracts": {
    "provider": true
  },
  "permissions": ["network:outbound"],
  "configSchema": {
    "type": "object",
    "properties": {
      "api_key": { "type": "string", "description": "Anthropic API key." },
      "default_model": { "type": "string", "default": "claude-sonnet-4-6" },
      "max_output_tokens": { "type": "integer", "default": 8192 }
    },
    "required": ["api_key"]
  }
}
