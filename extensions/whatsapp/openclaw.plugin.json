{
  "id": "whatsapp",
  "name": "WhatsApp",
  "description": "OpenClaw WhatsApp channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "whatsapp"
  ],
  "channelEnvVars": {
    "whatsapp": [
      "WHATSAPP_BUSINESS_TOKEN",
      "WHATSAPP_PHONE_ID"
