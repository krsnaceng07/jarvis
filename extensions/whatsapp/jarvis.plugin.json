{
  "id": "whatsapp",
  "name": "WhatsApp",
  "description": "WhatsApp messaging and desktop automation provider.",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "skills": [
    "./skills"
  ],
  "contracts": {
    "tools": [
      "whatsapp_get_state",
      "whatsapp_open",
      "whatsapp_search_contact",
      "whatsapp_open_chat",
      "whatsapp_send_message",
      "whatsapp_verify_message"
    ]
  },
  "channels": [
    "whatsapp"
  ],
  "channelEnvVars": {
    "whatsapp": [
      "WHATSAPP_BUSINESS_TOKEN",
      "WHATSAPP_PHONE_ID"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  },
  "kind": "channel"
}
