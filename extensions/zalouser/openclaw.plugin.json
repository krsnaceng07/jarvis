{
  "id": "zalouser",
  "name": "Zalo User",
  "description": "OpenClaw Zalo User channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "zalouser"
  ],
  "channelEnvVars": {
    "zalouser": [
      "ZALO_USER_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
