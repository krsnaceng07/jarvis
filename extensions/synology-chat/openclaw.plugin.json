{
  "id": "synology-chat",
  "name": "Synology Chat",
  "description": "OpenClaw Synology Chat channel plugin port (Phase 5.15 stub).",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "synology-chat"
  ],
  "channelEnvVars": {
    "synology-chat": [
      "SYNOLOGY_CHAT_WEBHOOK_URL",
      "SYNOLOGY_CHAT_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bot_token": {
        "type": "string"
      },
      "polling_interval_sec": {
        "type": "integer",
        "default": 5
      }
    }
  }
}
