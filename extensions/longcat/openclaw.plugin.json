{
  "id": "longcat",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "longcat"
  ],
  "setup": {
    "providers": [
      {
        "id": "longcat",
        "authMethods": [
          "api-key"
        ],
        "envVars": [
          "LONGCAT_API_KEY"
        ]
      }
    ]
  },
  "modelCatalog": {
    "providers": {
      "longcat": {
        "baseUrl": "https://api.longcat.ai/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "longcat-128k",
            "input": [
              "text"
            ]
          }
        ]
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "default_model": {
        "type": "string"
      },
      "max_output_tokens": {
        "type": "integer"
      }
    }
  },
  "kind": "provider"
}
