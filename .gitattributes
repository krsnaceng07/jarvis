# JARVIS .gitattributes
# Line endings: auto-detect by default, normalize to LF for code/config,
# CRLF for Windows shell scripts. Binary files declared explicitly.

# ─────────────────────────────────────────────────────────────────────
# Text files — default to LF (Unix line endings)
# ─────────────────────────────────────────────────────────────────────
* text=auto eol=lf

# ─────────────────────────────────────────────────────────────────────
# Windows shell scripts — keep CRLF (Windows-native)
# ─────────────────────────────────────────────────────────────────────
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.psm1          text eol=crlf

# ─────────────────────────────────────────────────────────────────────
# Code and config — explicit LF
# ─────────────────────────────────────────────────────────────────────
*.py            text eol=lf
*.pyi           text eol=lf
*.toml          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.ini           text eol=lf
*.cfg           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf

# ─────────────────────────────────────────────────────────────────────
# Binary files (declared explicitly so Git never tries to diff them)
# ─────────────────────────────────────────────────────────────────────
# Images
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.bmp           binary
*.ico           binary
*.svg           text

# Audio / video
*.wav           binary
*.mp3           binary
*.ogg           binary
*.flac          binary
*.m4a           binary
*.opus          binary
*.mp4           binary
*.mov           binary
*.avi           binary
*.mkv           binary
*.webm          binary

# Documents
*.pdf           binary
*.doc           binary
*.docx          binary
*.xls           binary
*.xlsx          binary
*.ppt           binary
*.pptx          binary

# Archives
*.zip           binary
*.tar           binary
*.gz            binary
*.bz2           binary
*.xz            binary
*.7z            binary
*.rar           binary

# Python distribution
*.whl           binary
*.egg           binary
*.egg-info      text
*.tar.gz        binary

# Native binaries
*.exe           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.pyd           binary

# Build artifacts
*.spec          binary
*.pyc           binary
*.pyo           binary
*.pdb           binary

# OpenClaw reference (vendored; do not normalize)
openclaw-main/** binary

# ─────────────────────────────────────────────────────────────────────
# Git attributes
# ─────────────────────────────────────────────────────────────────────
# Use git diff with --color-moved for Python
*.py            diff=python
# Use markdown diff for markdown files
*.md            diff=markdown
